diff --git a/cpp/rnskia/RNDawnWindowContext.cpp b/cpp/rnskia/RNDawnWindowContext.cpp
index 2f1c37f8cd064061eb1a9c4cf14f6e05284626ed..2e6dcdb50899ba38d9786d3cefdabf878d913631 100644
--- a/cpp/rnskia/RNDawnWindowContext.cpp
+++ b/cpp/rnskia/RNDawnWindowContext.cpp
@@ -25,17 +25,29 @@ bool DawnWindowContext::presentRecordings(
     return false;
   }
   // The surface only names the replay target; wrapping the swapchain texture
-  // records nothing on the window's recorder.
+  // records nothing. It still registers a device with the recorder it's
+  // wrapped on, and a recorder only drops the devices it tracks when it's
+  // snapped, so it's wrapped on a recorder of the window's own that's snapped
+  // after every frame (the shared one is never snapped here, and its list of
+  // devices, scanned whenever one is destroyed, grew a frame at a time).
+  if (!_presentRecorder) {
+    _presentRecorder = DawnContext::getInstance().makeRecorder();
+    if (!_presentRecorder) {
+      return false;
+    }
+  }
   auto backendTex = skgpu::graphite::BackendTextures::MakeDawn(texture.Get());
   SkSurfaceProps surfaceProps;
   auto surface = SkSurfaces::WrapBackendTexture(
-      _recorder, backendTex, DawnUtils::viewColorSpace(_useP3ColorSpace),
-      &surfaceProps);
+      _presentRecorder.get(), backendTex,
+      DawnUtils::viewColorSpace(_useP3ColorSpace), &surfaceProps);
   if (!surface) {
     return false;
   }
   bool success =
       DawnContext::getInstance().insertRecordings(recordings, surface.get());
+  surface.reset();
+  _presentRecorder->snap();
 #ifdef __APPLE__
   dawn::native::metal::WaitForCommandsToBeScheduled(_device.Get());
 #endif
